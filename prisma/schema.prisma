// Prisma schema for Rakib Panjabi House
// Database: Supabase PostgreSQL
// Designed for premium e-commerce with full features

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================
// USER & AUTHENTICATION
// ============================================

model User {
  id                  String     @id @default(cuid())
  email               String     @unique
  emailVerified       DateTime?
  password            String?
  name                String?
  image               String?
  phone               String?    @unique
  role                UserRole   @default(CUSTOMER)
  status              UserStatus @default(ACTIVE)
  preferredLang       String     @default("en")
  preferredCurrency   String     @default("BDT")
  emailMarketingOptIn Boolean    @default(true)
  smsMarketingOptIn   Boolean    @default(false)
  lastLoginAt         DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  // Relations
  accounts       Account[]
  sessions       Session[]
  addresses      Address[]
  orders         Order[]
  cart           Cart?
  wishlistItems  WishlistItem[]
  compareItems   CompareItem[]
  reviews        Review[]
  recentlyViewed RecentlyViewed[]
  notifications  Notification[]
  blogPosts      BlogPost[]
  blogComments   BlogComment[]
  couponsUsed    OrderCoupon[]
  supportTickets SupportTicket[]
  refunds        Refund[]

  @@index([role, status])
  @@index([createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  STAFF
  CUSTOMER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

// ============================================
// CATALOG: Categories, Brands, Products
// ============================================

model Category {
  id             String     @id @default(cuid())
  name           String
  slug           String     @unique
  description    String?
  image          String?
  icon           String?
  parentId       String?
  parent         Category?  @relation("CategoryParent", fields: [parentId], references: [id], onDelete: SetNull)
  children       Category[] @relation("CategoryParent")
  order          Int        @default(0)
  isFeatured     Boolean    @default(false)
  isActive       Boolean    @default(true)
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  products Product[]
  banners  Banner[]

  @@index([parentId, isActive])
  @@index([slug])
}

model Brand {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  logo        String?
  website     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]

  @@index([slug])
}

model Product {
  id               String        @id @default(cuid())
  name             String
  slug             String        @unique
  sku              String        @unique
  description      String
  shortDescription String?
  fabric           String?
  fit              String?
  care             String?
  origin           String?
  brandId          String?
  categoryId       String
  price            Decimal       @db.Decimal(10, 2)
  discountPrice    Decimal?      @db.Decimal(10, 2)
  costPrice        Decimal?      @db.Decimal(10, 2)
  currency         String        @default("BDT")
  status           ProductStatus @default(DRAFT)
  type             ProductType   @default(PHYSICAL)
  isFeatured       Boolean       @default(false)
  isBestSeller     Boolean       @default(false)
  isNewArrival     Boolean       @default(false)
  isFlashSale      Boolean       @default(false)
  allowPreorder    Boolean       @default(false)
  allowReviews     Boolean       @default(true)
  allowReturns     Boolean       @default(true)
  metaTitle        String?
  metaDescription  String?
  searchKeywords   String?
  video            String?
  weightKg         Decimal?      @db.Decimal(8, 2)
  publishedAt      DateTime?
  flashSaleStart   DateTime?
  flashSaleEnd     DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  // Relations
  brand                    Brand?                            @relation(fields: [brandId], references: [id], onDelete: SetNull)
  category                 Category                          @relation(fields: [categoryId], references: [id])
  images                   ProductImage[]
  variants                 ProductVariant[]
  sizes                    ProductSize[]
  colors                   ProductColor[]
  specifications           ProductSpecification[]
  tags                     ProductTag[]
  reviews                  Review[]
  cartItems                CartItem[]
  wishlistItems            WishlistItem[]
  compareItems             CompareItem[]
  recentlyViewed           RecentlyViewed[]
  orderItems               OrderItem[]
  bundleItems              BundleItem[]
  bundles                  Bundle[]                          @relation("BundleProducts")
  frequentlyBoughtTogether ProductFrequentlyBoughtTogether[] @relation("FbtProduct")
  frequentlyBoughtRelated  ProductFrequentlyBoughtTogether[] @relation("FbtRelated")

  @@index([categoryId, status])
  @@index([slug])
  @@index([sku])
  @@index([isFeatured, status])
  @@index([isBestSeller, status])
  @@index([isNewArrival, status])
  @@index([isFlashSale, status])
  @@index([brandId])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  altText   String?
  width     Int?
  height    Int?
  position  Int     @default(0)
  isPrimary Boolean @default(false)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([isPrimary])
}

model ProductVariant {
  id        String   @id @default(cuid())
  productId String
  name      String
  sku       String   @unique
  barcode   String?
  price     Decimal? @db.Decimal(10, 2)
  stock     Int      @default(0)
  weightKg  Decimal? @db.Decimal(8, 2)
  isActive  Boolean  @default(true)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductSize {
  id        String @id @default(cuid())
  productId String
  size      String
  stock     Int    @default(0)
  sortOrder Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, size])
  @@index([productId])
}

model ProductColor {
  id        String  @id @default(cuid())
  productId String
  name      String
  hexValue  String
  image     String?
  stock     Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, name])
  @@index([productId])
}

model ProductSpecification {
  id        String @id @default(cuid())
  productId String
  name      String
  value     String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductTag {
  id        String @id @default(cuid())
  productId String
  tag       String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, tag])
  @@index([tag])
}

model ProductFrequentlyBoughtTogether {
  id        String @id @default(cuid())
  productId String
  relatedId String
  frequency Int    @default(0)

  product Product @relation("FbtProduct", fields: [productId], references: [id], onDelete: Cascade)
  related Product @relation("FbtRelated", fields: [relatedId], references: [id], onDelete: Cascade)

  @@unique([productId, relatedId])
}

model Bundle {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  description   String?
  price         Decimal  @db.Decimal(10, 2)
  discountPrice Decimal? @db.Decimal(10, 2)
  image         String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  products Product[]    @relation("BundleProducts")
  items    BundleItem[]
}

model BundleItem {
  id        String @id @default(cuid())
  bundleId  String
  productId String
  quantity  Int    @default(1)

  bundle  Bundle  @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([bundleId, productId])
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
  OUT_OF_STOCK
  DISCONTINUED
}

enum ProductType {
  PHYSICAL
  DIGITAL
  SERVICE
  BUNDLE
}

// ============================================
// CART & WISHLIST
// ============================================

model Cart {
  id        String   @id @default(cuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@index([userId])
}

model CartItem {
  id                String   @id @default(cuid())
  cartId            String
  productId         String
  quantity          Int      @default(1)
  selectedSize      String?
  selectedColor     String?
  selectedVariantId String?
  addedAt           DateTime @default(now())

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId, selectedSize, selectedColor])
  @@index([cartId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
}

model CompareItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
}

model RecentlyViewed {
  id        String   @id @default(cuid())
  userId    String
  productId String
  viewedAt  DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId, viewedAt])
}

// ============================================
// ORDERS & PAYMENTS
// ============================================

model Order {
  id                   String            @id @default(cuid())
  orderNumber          String            @unique
  userId               String
  status               OrderStatus       @default(PENDING)
  paymentStatus        PaymentStatus     @default(UNPAID)
  fulfillmentStatus    FulfillmentStatus @default(UNFULFILLED)
  // Totals
  subtotal             Decimal           @db.Decimal(10, 2)
  discountTotal        Decimal           @default(0) @db.Decimal(10, 2)
  shippingTotal        Decimal           @default(0) @db.Decimal(10, 2)
  taxTotal             Decimal           @default(0) @db.Decimal(10, 2)
  grandTotal           Decimal           @db.Decimal(10, 2)
  currency             String            @default("BDT")
  // Customer info (snapshot)
  customerName         String
  customerEmail        String
  customerPhone        String
  // Shipping
  shippingAddressJson  String
  billingAddressJson   String?
  shippingMethod       String?
  shippingProvider     String?
  trackingNumber       String?
  trackingUrl          String?
  // Payment
  paymentMethod        String?
  paymentId            String?
  paymentTransactionId String?
  paidAt               DateTime?
  // Notes
  customerNote         String?
  adminNote            String?
  cancellationReason   String?
  // Source
  source               String            @default("WEB")
  // Timestamps
  placedAt             DateTime          @default(now())
  confirmedAt          DateTime?
  shippedAt            DateTime?
  deliveredAt          DateTime?
  cancelledAt          DateTime?
  returnedAt           DateTime?
  refundedAt           DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  user            User                   @relation(fields: [userId], references: [id])
  items           OrderItem[]
  coupons         OrderCoupon[]
  transactions    PaymentTransaction[]
  refunds         Refund[]
  trackingHistory OrderTrackingHistory[]

  @@index([userId, status])
  @@index([orderNumber])
  @@index([status, paymentStatus])
  @@index([placedAt])
}

model OrderItem {
  id                String   @id @default(cuid())
  orderId           String
  productId         String
  name              String
  sku               String
  image             String?
  quantity          Int
  price             Decimal  @db.Decimal(10, 2)
  discountPrice     Decimal? @db.Decimal(10, 2)
  total             Decimal  @db.Decimal(10, 2)
  selectedSize      String?
  selectedColor     String?
  selectedVariantId String?
  // Snapshot data
  productSnapshot   Json

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

model OrderCoupon {
  id             String  @id @default(cuid())
  orderId        String
  couponId       String
  code           String
  discountAmount Decimal @db.Decimal(10, 2)
  userId         String

  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  coupon Coupon @relation(fields: [couponId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([orderId])
  @@index([couponId])
}

model OrderTrackingHistory {
  id        String   @id @default(cuid())
  orderId   String
  status    String
  message   String?
  location  String?
  timestamp DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, timestamp])
}

model PaymentTransaction {
  id            String   @id @default(cuid())
  orderId       String
  provider      String
  transactionId String?
  amount        Decimal  @db.Decimal(10, 2)
  currency      String   @default("BDT")
  status        String
  method        String?
  rawResponse   Json?
  errorMessage  String?
  processedAt   DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([transactionId])
}

model Refund {
  id          String       @id @default(cuid())
  orderId     String
  userId      String
  amount      Decimal      @db.Decimal(10, 2)
  reason      String
  status      RefundStatus @default(PENDING)
  processedBy String?
  processedAt DateTime?
  createdAt   DateTime     @default(now())

  order Order @relation(fields: [orderId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@index([orderId])
  @@index([status])
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
  REFUNDED
  FAILED
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  PARTIALLY_PAID
  REFUNDED
  PARTIALLY_REFUNDED
  FAILED
  CANCELLED
}

enum FulfillmentStatus {
  UNFULFILLED
  PARTIALLY_FULFILLED
  FULFILLED
  SHIPPED
  DELIVERED
  RETURNED
}

enum RefundStatus {
  PENDING
  APPROVED
  REJECTED
  PROCESSED
  FAILED
}

// ============================================
// ADDRESSES
// ============================================

model Address {
  id           String      @id @default(cuid())
  userId       String
  type         AddressType @default(SHIPPING)
  firstName    String
  lastName     String?
  phone        String
  altPhone     String?
  addressLine1 String
  addressLine2 String?
  city         String
  district     String?
  thana        String?
  postalCode   String?
  country      String      @default("Bangladesh")
  isDefault    Boolean     @default(false)
  label        String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

enum AddressType {
  SHIPPING
  BILLING
  BOTH
}

// ============================================
// COUPONS & DISCOUNTS
// ============================================

model Coupon {
  id            String          @id @default(cuid())
  code          String          @unique
  description   String?
  type          CouponType      @default(PERCENTAGE)
  value         Decimal         @db.Decimal(10, 2)
  minOrder      Decimal?        @db.Decimal(10, 2)
  maxDiscount   Decimal?        @db.Decimal(10, 2)
  usageLimit    Int?
  perUserLimit  Int             @default(1)
  usedCount     Int             @default(0)
  startsAt      DateTime
  expiresAt     DateTime?
  isActive      Boolean         @default(true)
  appliesTo     CouponAppliesTo @default(ALL)
  categoryIds   String[]
  productIds    String[]
  firstTimeOnly Boolean         @default(false)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  orderCoupons OrderCoupon[]

  @@index([code, isActive])
  @@index([expiresAt])
}

model GiftVoucher {
  id             String    @id @default(cuid())
  code           String    @unique
  amount         Decimal   @db.Decimal(10, 2)
  balance        Decimal   @db.Decimal(10, 2)
  currency       String    @default("BDT")
  recipientEmail String?
  recipientName  String?
  senderName     String?
  message        String?
  expiresAt      DateTime?
  isRedeemed     Boolean   @default(false)
  redeemedAt     DateTime?
  redeemedById   String?
  createdAt      DateTime  @default(now())

  @@index([code])
}

enum CouponType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
  BUY_X_GET_Y
}

enum CouponAppliesTo {
  ALL
  SPECIFIC_CATEGORIES
  SPECIFIC_PRODUCTS
  SPECIFIC_BRANDS
}

// ============================================
// REVIEWS & RATINGS
// ============================================

model Review {
  id              String       @id @default(cuid())
  productId       String
  userId          String
  orderId         String?
  rating          Int
  title           String?
  content         String?
  images          String[]
  isVerified      Boolean      @default(false)
  isFeatured      Boolean      @default(false)
  status          ReviewStatus @default(PENDING)
  helpfulCount    Int          @default(0)
  notHelpfulCount Int          @default(0)
  response        String?
  respondedAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId, orderId])
  @@index([productId, status])
  @@index([userId])
  @@index([rating])
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
  SPAM
}

// ============================================
// BANNERS & HOMEPAGE CONTENT
// ============================================

model Banner {
  id          String         @id @default(cuid())
  title       String
  subtitle    String?
  image       String
  mobileImage String?
  linkUrl     String?
  linkText    String?
  position    BannerPosition @default(HOMEPAGE_HERO)
  categoryId  String?
  startDate   DateTime?
  endDate     DateTime?
  order       Int            @default(0)
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([position, isActive])
  @@index([categoryId])
}

enum BannerPosition {
  HOMEPAGE_HERO
  HOMEPAGE_PROMO
  HOMEPAGE_FEATURED
  SHOP_PAGE
  CATEGORY_PAGE
  SIDEBAR
  FOOTER
  ANNOUNCEMENT
  POPUP
}

// ============================================
// BLOG
// ============================================

model BlogPost {
  id              String     @id @default(cuid())
  title           String
  slug            String     @unique
  excerpt         String?
  content         String
  coverImage      String?
  category        String?
  tags            String[]
  authorId        String
  status          BlogStatus @default(DRAFT)
  isFeatured      Boolean    @default(false)
  viewCount       Int        @default(0)
  likeCount       Int        @default(0)
  metaTitle       String?
  metaDescription String?
  publishedAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  author   User          @relation(fields: [authorId], references: [id])
  comments BlogComment[]

  @@index([slug])
  @@index([status, publishedAt])
  @@index([isFeatured])
}

model BlogComment {
  id        String        @id @default(cuid())
  postId    String
  userId    String
  parentId  String?
  name      String?
  email     String?
  content   String
  status    CommentStatus @default(PENDING)
  createdAt DateTime      @default(now())

  post    BlogPost      @relation(fields: [postId], references: [id], onDelete: Cascade)
  user    User          @relation(fields: [userId], references: [id], onDelete: SetNull)
  parent  BlogComment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies BlogComment[] @relation("CommentReplies")

  @@index([postId, status])
}

enum BlogStatus {
  DRAFT
  PUBLISHED
  SCHEDULED
  ARCHIVED
}

enum CommentStatus {
  PENDING
  APPROVED
  REJECTED
  SPAM
}

// ============================================
// NOTIFICATIONS & SUPPORT
// ============================================

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  data      Json?
  isRead    Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
}

model SupportTicket {
  id           String         @id @default(cuid())
  ticketNumber String         @unique
  userId       String
  subject      String
  message      String
  status       TicketStatus   @default(OPEN)
  priority     TicketPriority @default(NORMAL)
  assignedTo   String?
  closedAt     DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId, status])
  @@index([status, priority])
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_CUSTOMER
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

// ============================================
// SETTINGS (key-value)
// ============================================

model Setting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  type        String   @default("string")
  description String?
  updatedAt   DateTime @updatedAt

  @@index([key])
}

// ============================================
// NEWSLETTER SUBSCRIBERS
// ============================================

model NewsletterSubscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String?
  isActive       Boolean   @default(true)
  source         String    @default("WEBSITE")
  subscribedAt   DateTime  @default(now())
  unsubscribedAt DateTime?
  metadata       Json?

  @@index([email])
}
